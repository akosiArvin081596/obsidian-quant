# Optional overrides — only for the repo / deploy owner.
# Contributors do not need this file; defaults in src/lib/contact.ts already
# deliver to access@obsidianquantgroup.com via FormSubmit.

# NEXT_PUBLIC_CONTACT_INBOX=access@obsidianquantgroup.com
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/access@obsidianquantgroup.com

# CRM lead intake defaults to the SAME-ORIGIN /api/lead nginx proxy (which injects
# the bearer secret server-side — see DEPLOY.md), so no env is needed in prod.
# Override ONLY to send leads to a different collector; a cross-origin value also
# needs a CSP connect-src update in nginx-security-headers.conf + root layout CSP.
# NEXT_PUBLIC_CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# DEV ONLY — where `next dev` rewrites /api/lead. Unset, /api/lead 404s locally,
# which is harmless: the CRM leg is detached and never gates the UI, so the
# outbound payload is still fully inspectable in DevTools. Point it at a local
# echo server to see the body land. Never point it at the live CRM (the bearer is
# injected by nginx, so you would only get a 401) or at production (it would
# write real leads).
# LEAD_DEV_PROXY_TARGET=http://localhost:8081/

# --- Blog CMS (required for admin + published blog data) ---
# Local Docker: docker compose up -d  (maps host 5433 → container 5432; avoids Laragon's :5432)
# DATABASE_URL="postgresql://obsidian:obsidian@localhost:5433/obsidian_quant?schema=public"
DATABASE_URL=

# Absolute or relative path for uploaded media (served at /uploads/*)
# UPLOADS_DIR=./uploads

# Seed admin. Optional — defaults to admin@obsidianquantgroup.com.
# ADMIN_SEED_EMAIL=admin@obsidianquantgroup.com

# REQUIRED for `npm run db:seed` — there is NO default password. The seed fails
# closed: unset (or under 8 chars) it throws and writes nothing, so a database
# can never come up holding a password that was published in this repo. Choose a
# fresh value per environment and keep it out of git — .env is gitignored, this
# file is not.
# Re-seeding is NOT a password reset: if the admin already exists the seed leaves
# its hash and status untouched (a suspended account stays suspended) and ignores
# whatever you set here. Change passwords in the admin UI instead.
# Export this BEFORE `npm run db:migrate` as well: db:migrate is `prisma migrate
# dev`, which fires the prisma.seed hook on a fresh database and aborts without it.
ADMIN_SEED_PASSWORD=

# --- Acceptance QA harness (`npm run qa:acceptance`) ---
# All three are REQUIRED, alongside ADMIN_SEED_PASSWORD above. The suite checks
# for them and exits 1 before its first request, because a half-run leaves
# half-mutated accounts behind. None has a fallback literal, for the same reason
# the seed no longer does: this harness does not merely read these accounts — it
# CREATES the Author user, PATCHes an existing one back to this password and
# status "active", and stands up a throwaway qa-user-<runId> manager. A default
# baked into the script would be a working password for a live, re-activated
# account, published in a public repo.
# Point the run at a disposable database — never production.
# QA_AUTHOR_EMAIL=qa-author@example.com   # Author-role account the suite creates/resets
# QA_AUTHOR_PASSWORD=                     # password the suite sets on that account
# QA_MANAGER_PASSWORD=                    # password for the per-run throwaway manager

# --- §3.2 AI assists (Groq) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- §3.2 Analytics (optional GA4 Data API) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_PROPERTY_ID=123456789
# GA_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
